{
  // These tests import src/embed, which is the one part of this repository that
  // runs in a browser. They need the same program shape it has — the DOM lib, and
  // *not* the Worker's ambient types, which redeclare `fetch` and `Response` with
  // Cloudflare's shapes. Two libs in one program is how `document` ends up typed
  // against a runtime that has none, which is why src/embed has its own project
  // and why these tests cannot live under test/tsconfig.json.
  //
  // test/tsconfig.json excludes this directory for that reason, and `pnpm
  // typecheck` runs this project as a fourth.
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "lib": ["esnext", "dom", "dom.iterable"],
    "types": []
  },
  // The root project's `include` is inherited through `extends` and points at
  // src, so it has to be replaced here or this project has no inputs at all.
  "include": ["./**/*.ts"],
  "exclude": []
}
